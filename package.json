{
  "name": "wti-mcp",
  "version": "0.1.0",
  "description": "MCP server for WebTranslateIt: look up, create and translate strings, check stats, manage the glossary and sync language files.",
  "type": "module",
  "bin": {
    "wti-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "webtranslateit",
    "wti",
    "i18n",
    "translations"
  ],
  "author": "Jorge Garrido",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireZenk/wti-mcp.git"
  },
  "homepage": "https://github.com/FireZenk/wti-mcp#readme",
  "bugs": {
    "url": "https://github.com/FireZenk/wti-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
